# Keys needed to run cognitive-overload (copy to .env or set in the repo-root .env).
# The script auto-loads the nearest .env (unit-local first, else repo root).

# Required — target LLM + the in-tool veiled-expression paraphraser both call OpenRouter.
OPENROUTER_API_KEY=

# Optional — only if you choose to live-back-translate non-English target replies for the
# substring judge (the run otherwise FLAGS non-latin replies as needs_back_translation).
# The 52-language attack prompts ship pre-translated under data/, so no key is needed for them.
GOOGLE_TRANSLATE_API_KEY=
