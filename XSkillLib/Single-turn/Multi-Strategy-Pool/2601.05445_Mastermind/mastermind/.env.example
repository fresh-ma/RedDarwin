# Mastermind (2601.05445) — API keys for the black-box roles.
# All roles (planner/executor/controller/target/judge) are OpenAI-compatible chat
# calls. Copy to .env and fill in. The loader reads the nearest .env (this dir first).

# OpenRouter (default gateway for api:<model>, e.g. api:deepseek/deepseek-v4-flash)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI-direct (used if OPENAI_BASE_URL is set / no OpenRouter key)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
